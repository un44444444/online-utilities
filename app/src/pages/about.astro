---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于在线工具箱。">
  <h1 class="text-2xl font-bold mb-4">关于</h1>
  <div class="space-y-3 leading-7">
    <p>一个干净、免费、纯前端的在线工具箱。技术栈：Astro + Vue 3 + Tailwind CSS，全站静态生成，托管于 Cloudflare Pages。</p>
    <p>项目代码以开源方式托管在 GitHub，欢迎提交工具建议与 Issue。</p>
  </div>
</BaseLayout>
