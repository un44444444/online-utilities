---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

const sections: { key: 'everyone' | 'developers' | 'codegen'; title: string; blurb: string }[] = [
  { key: 'everyone', title: '所有人都在用', blurb: '无需任何技术背景，打开即用' },
  { key: 'developers', title: '开发者工具', blurb: '格式化、编解码、调试利器' },
  { key: 'codegen', title: '代码生成器', blurb: '生成代码，更讲清每一行为什么' },
];

const byCategory = (key: string) =>
  tools.filter((t) => t.data.category === key).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="在线工具箱"
  description="干净、免费、纯前端的在线工具箱：密码生成、图片处理、JSON 格式化、编解码与正则工具。所有处理在浏览器本地完成，数据不上传。"
>
  <section class="text-center py-10">
    <h1 class="text-3xl font-bold">一个干净、免费、纯前端的在线工具箱</h1>
    <p class="mt-3 text-neutral-500 dark:text-neutral-400 max-w-2xl mx-auto">
      所有工具均在您的浏览器中本地运行，无需注册，没有广告，数据不会上传服务器。
    </p>
  </section>

  {
    sections.map((sec) => (
      <section class="mb-10">
        <h2 class="text-xl font-semibold">{sec.title}</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">{sec.blurb}</p>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-4">
          {byCategory(sec.key).map((t) => (
            <li>
              <a
                href={`/${t.data.path}`}
                class="block h-full rounded-xl border border-neutral-200 dark:border-neutral-800 p-5 hover:border-sky-400 dark:hover:border-sky-600 hover:shadow-sm transition-all"
              >
                <span class="font-medium">{t.data.name}</span>
                <span class="block text-sm text-neutral-500 dark:text-neutral-400 mt-1.5 leading-6">
                  {t.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
