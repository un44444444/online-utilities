---
import BaseLayout from './BaseLayout.astro';

interface Props {
  name: string;
  description: string;
  path: string;
  related?: { name: string; path: string; description: string }[];
}

const { name, description, path, related = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  url: new URL('/' + path, Astro.site ?? Astro.url.origin),
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (Web Browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
};
---

<BaseLayout title={name} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <h1 class="text-2xl font-bold mb-2">{name}</h1>
    <p class="text-neutral-500 dark:text-neutral-400 mb-6">{description}</p>
    <slot />
    {
      related.length > 0 && (
        <section class="mt-10">
          <h2 class="text-lg font-semibold mb-3">相关工具</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {related.map((r) => (
              <li>
                <a
                  href={`/${r.path}`}
                  class="block rounded-lg border border-neutral-200 dark:border-neutral-800 p-4 hover:border-sky-400 dark:hover:border-sky-600 transition-colors"
                >
                  <span class="font-medium">{r.name}</span>
                  <span class="block text-sm text-neutral-500 dark:text-neutral-400 mt-1">{r.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
